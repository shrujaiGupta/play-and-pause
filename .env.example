# Copy to `.env.local` and fill in. `.env*` is gitignored; this file is
# committed and documents what the site needs.

# Where playandpause-backend is listening. Only ever called from the server
# during rendering, so it is not a NEXT_PUBLIC_ variable and never reaches the
# browser.
#
#   local backend -> http://127.0.0.1:8080
#   production    -> https://api.playandpause.club
API_BASE_URL=http://127.0.0.1:8080
