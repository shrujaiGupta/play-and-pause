# Copy to `.env.local` and fill in. `.env*` is gitignored; this file is
# committed and documents what the site needs.

# Where playandpause-backend is listening. Only ever called from the server
# during rendering, so it is not a NEXT_PUBLIC_ variable and never reaches the
# browser.
#
#   local backend -> http://127.0.0.1:8080
#   production    -> https://api.playandpause.club
API_BASE_URL=http://127.0.0.1:8080

# Shared with REVALIDATE_SECRET in the backend. The backend sends it in the
# x-revalidate-secret header when it POSTs /api/revalidate after the live event
# changes; the route rejects anything else.
#
# Leave it unset and /api/revalidate refuses every request, which is the safe
# default — the event card then refreshes on its own 5 minute window instead of
# instantly. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=CHANGE_ME
